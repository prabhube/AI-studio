# ============================================================
# Prabhu AI Studio — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------
# Application
# ----------------------------
APP_NAME=Prabhu AI Studio
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-secure-random-64-char-string
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----------------------------
# Backend
# ----------------------------
BACKEND_PORT=8000

# ----------------------------
# Frontend
# ----------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ----------------------------
# PostgreSQL
# ----------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=prabhu
POSTGRES_PASSWORD=prabhu_secret
POSTGRES_DB=prabhu_ai_studio
DATABASE_URL=postgresql+asyncpg://prabhu:prabhu_secret@postgres:5432/prabhu_ai_studio

# ----------------------------
# Redis
# ----------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_DB=0
REDIS_URL=redis://:redis_secret@redis:6379/0

# ----------------------------
# JWT Authentication
# ----------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ----------------------------
# Google OAuth (optional)
# ----------------------------
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Set authorized redirect URIs to: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
OAUTH_STATE_TTL=600

# ----------------------------
# Rate Limiting
# ----------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ----------------------------
# AI Providers
# ----------------------------
# LLM: gemma | llama | none
LLM_PROVIDER=gemma
LLM_MODEL_PATH=/models/llm/gemma-2b-it.gguf
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# Image: stable_diffusion | none
IMAGE_PROVIDER=stable_diffusion
SD_MODEL_PATH=/models/sd/v1-5-pruned-emaonly.safetensors
SD_OUTPUT_DIR=/app/media/images
SD_DEFAULT_WIDTH=512
SD_DEFAULT_HEIGHT=512
SD_DEFAULT_STEPS=20

# TTS: piper | none
TTS_PROVIDER=piper
PIPER_MODEL_PATH=/models/tts/en_US-lessac-medium.onnx
TTS_OUTPUT_DIR=/app/media/audio

# STT: whisper | none
STT_PROVIDER=whisper
WHISPER_MODEL_SIZE=base
STT_OUTPUT_DIR=/app/media/transcripts

# Video: ffmpeg | none
VIDEO_PROVIDER=ffmpeg
FFMPEG_OUTPUT_DIR=/app/media/videos

# ----------------------------
# Media Storage
# ----------------------------
MEDIA_ROOT=/app/media
MAX_UPLOAD_SIZE_MB=500
