# =============================================================================
# Prabhu AI Studio — Frontend Environment Variables
# =============================================================================
#
# Copy this file to .env.local and fill in the values.
# NEXT_PUBLIC_* variables are exposed to the browser bundle.
# Variables without NEXT_PUBLIC_ are server-only (never sent to the client).
#
# Usage:
#   cp .env.local.example .env.local
# =============================================================================

# ---- API Configuration ----

# Base URL for the FastAPI backend (without trailing slash).
# In Docker Compose this should be http://backend:8000/api/v1 (server-side)
# but for browser requests it should be http://localhost:8000/api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ---- Application ----

NEXT_PUBLIC_APP_NAME=Prabhu AI Studio
NEXT_PUBLIC_APP_VERSION=1.0.0

# Full public URL of this frontend (used for og:image etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Feature flags ----

# Show ReactQuery devtools in browser (default: true in development)
NEXT_PUBLIC_SHOW_DEVTOOLS=true

# API request timeout in milliseconds (default: 30000)
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# How often to poll the /health endpoint in milliseconds.
# Set to 0 to disable polling.
NEXT_PUBLIC_HEALTH_POLL_INTERVAL_MS=30000
